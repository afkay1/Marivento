# Public URL (canonical links, sitemap, Open Graph, Stripe return URLs)
NEXT_PUBLIC_SITE_URL=https://marivento-hotel.vercel.app

# Secret used to sign booking confirmation links. Set any long random string in production.
BOOKING_SECRET=

# --- Optional: everything below switches the demo to live services ---

# Postgres (Vercel Storage > Neon, or any Postgres). Run db/schema.sql once.
DATABASE_URL=

# Password for /admin when a database is connected
ADMIN_PASSWORD=

# Stripe TEST mode secret key (sk_test_...). Enables real Stripe Checkout.
STRIPE_SECRET_KEY=

# Resend: booking confirmation emails
RESEND_API_KEY=
EMAIL_FROM=
HOTEL_INBOX=

# Anthropic: live AI concierge (otherwise scripted demo answers)
ANTHROPIC_API_KEY=
CONCIERGE_MODEL=claude-sonnet-5-5
